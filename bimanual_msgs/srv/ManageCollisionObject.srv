# Add, remove or (de)attach a collision object in the planning world.
uint8 ADD=0
uint8 REMOVE=1
uint8 ATTACH=2     # attach an existing (or new) object to a robot link
uint8 DETACH=3     # detach an object back into the world
uint8 CLEAR=4      # remove every world object

uint8 operation

# Unique identifier of the object (ignored for CLEAR).
string id

# Geometry (used for ADD / ATTACH when the object does not exist yet). EITHER a
# primitive OR a mesh:
#   * mesh_resource empty -> primitive below (BOX, SPHERE or CYLINDER).
#   * mesh_resource set   -> a mesh (package:// or file://), loaded and
#     decimated / sphere-reduced like the robot's own meshes. mesh_scale scales
#     it (each component <= 0 is treated as 1).
shape_msgs/SolidPrimitive primitive
string mesh_resource
geometry_msgs/Vector3 mesh_scale

# Object pose. header.frame_id selects the reference frame; an empty frame_id
# defaults to the planning frame.
geometry_msgs/PoseStamped pose

# Link to attach the object to (ATTACH only). If no geometry is given, the
# already-present object with this id is attached where it currently sits
# (geometry preserved).
string attach_link

# ATTACH only: links allowed to touch the object (the gripper links). Links the
# object already touches when attached are allowed automatically.
string[] touch_links
---
bool success
string message
